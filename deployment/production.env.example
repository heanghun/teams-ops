# Blank template. Use hosting secret management. Do not commit completed credentials.
# Worker runtime variables and secrets. Set them in the hosting dashboard or secret manager.
TEAMS_MODE=team
TEAMS_APP_HOST=ops.teams.com.kh
TEAMS_ACCESS_AUD=
TEAMS_OWNER_EMAIL=
# Keep the current Access gateway during pilot verification. Set "teams" on the native sign-in deployment.
TEAMS_AUTH_MODE=access
TEAMS_AUTH_SECRET=
TEAMS_AUTH_EMAIL_FROM=
# Optional separate send-only key for sign-in codes. Defaults to the shared Resend key.
TEAMS_AUTH_RESEND_API_KEY=
TEAMS_TELEGRAM_CLIENT_ID=
TEAMS_TELEGRAM_CLIENT_SECRET=
TEAMS_TELEGRAM_BOT_TOKEN=
TEAMS_RESEND_API_KEY=
TEAMS_EMAIL_FROM=
TEAMS_RESEND_WEBHOOK_SECRET=
# Keep disabled through security and data-handling acceptance. Store the key as a secret.
TEAMS_AI_ENABLED=false
TEAMS_OPENAI_API_KEY=
TEAMS_OPENAI_MODEL=
TEAMS_AI_DAILY_LIMIT=30
TEAMS_AI_USER_DAILY_LIMIT=8
# Valid JSON with real verified receiving addresses supplied by TEAMS:
TEAMS_EMAIL_ROUTING={"installation":[],"maintenance":[],"general":[],"finance":[]}
# Bind production D1 as DB and private production R2 as BUCKET in the host.
# The Worker checks the Cloudflare Access context against the configured application audience.
# Do not enable staff-demo personnel bootstrap/import secrets in production.
